<Window x:Class="RdpLauncher.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RdpLauncher"
        Title="RDP" Icon="app.ico"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True"
        ShowInTaskbar="False" Width="260" SizeToContent="Height" MinHeight="60"
        WindowStartupLocation="Manual" Background="Transparent" AllowsTransparency="True"
        FontFamily="Segoe UI" FontSize="13">
  <Window.Resources>
    <SolidColorBrush x:Key="WidgetBg"           Color="White"/>
    <SolidColorBrush x:Key="WidgetBorderBrush"  Color="#CCCCCC"/>
    <SolidColorBrush x:Key="WidgetFg"           Color="#1E1E1E"/>
    <SolidColorBrush x:Key="WidgetMuted"        Color="Gray"/>
  </Window.Resources>

  <!--
    Layout: [Tab 20px] [Body 240px]
    Tab is always visible — rounded on the left (outward) side, flush on the right (body) side.
    When docked: window slides right until only the 20px tab is visible at the screen edge.
    Body starts at Margin="20,0,0,0" so it is fully off-screen when docked.
  -->
  <Grid>
    <!-- Pull-tab: permanent left-side handle -->
    <Border x:Name="PullTab" Width="20"
            HorizontalAlignment="Left" VerticalAlignment="Center" Height="72"
            Background="#CC2563EB" CornerRadius="8,0,0,8" Cursor="Hand"
            MouseLeftButtonDown="PullTab_Click">
      <TextBlock x:Name="PullTabArrow" Text="&#9654;" Foreground="White"
                 FontSize="9" FontWeight="Bold"
                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>

    <!-- Main widget body — left margin keeps it to the right of the tab -->
    <Border x:Name="OuterBorder" Margin="20,0,0,0"
            Background="{DynamicResource WidgetBg}"
            BorderBrush="{DynamicResource WidgetBorderBrush}"
            BorderThickness="1,1,1,1" CornerRadius="0,6,6,0">
      <DockPanel x:Name="MainContent">

        <!-- Header — no drag, opacity via mouse wheel -->
        <Border DockPanel.Dock="Top" Background="#2563EB" Height="26"
                MouseWheel="Header_MouseWheel">
          <Grid>
            <TextBlock Text="RDP" Foreground="White" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="10,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,4,0">
              <Button x:Name="BtnAutoHide" Content="&#8677;" ToolTip="Enable auto-hide"
                      Width="22" Height="22" Foreground="White" Background="Transparent"
                      BorderThickness="0" Click="BtnAutoHide_Click"/>
              <Button x:Name="BtnToggleExpand" Content="&#9660;" ToolTip="Collapse all groups"
                      Width="22" Height="22" Foreground="White" Background="Transparent"
                      BorderThickness="0" Click="BtnToggleExpand_Click"/>
              <Button x:Name="BtnManager" Content="&#9881;" ToolTip="Open manager"
                      Width="22" Height="22" Foreground="White" Background="Transparent"
                      BorderThickness="0" Click="BtnManager_Click"/>
              <Button x:Name="BtnHide" Content="&#215;" ToolTip="Hide to tray"
                      Width="22" Height="22" Foreground="White" Background="Transparent"
                      BorderThickness="0" Click="BtnHide_Click"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Update notification banner -->
        <Border x:Name="UpdateBanner" DockPanel.Dock="Bottom"
                Background="#D97706" Visibility="Collapsed"
                Cursor="Hand" MouseLeftButtonDown="UpdateBanner_Click" Padding="8,5">
          <TextBlock x:Name="UpdateText" Foreground="White" FontSize="11"
                     TextWrapping="Wrap"/>
        </Border>

        <TreeView x:Name="Tree" BorderThickness="0" Padding="2"
                  Background="Transparent"
                  Foreground="{DynamicResource WidgetFg}"
                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  MouseDoubleClick="Tree_MouseDoubleClick"
                  PreviewMouseRightButtonDown="Tree_PreviewMouseRightButtonDown">
          <TreeView.Resources>
            <HierarchicalDataTemplate DataType="{x:Type local:Group}" ItemsSource="{Binding Profiles}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                <TextBlock Text="{Binding Profiles.Count, StringFormat=' ({0})'}"
                           Foreground="{DynamicResource WidgetMuted}"/>
              </StackPanel>
            </HierarchicalDataTemplate>
            <DataTemplate DataType="{x:Type local:Profile}">
              <TextBlock Text="{Binding Name}"/>
            </DataTemplate>
          </TreeView.Resources>
          <TreeView.ItemContainerStyle>
            <Style TargetType="TreeViewItem">
              <Setter Property="IsExpanded" Value="True"/>
              <Setter Property="Foreground" Value="{DynamicResource WidgetFg}"/>
            </Style>
          </TreeView.ItemContainerStyle>
          <TreeView.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Connect" Click="MenuConnect_Click"/>
              <MenuItem Header="Copy credentials" Click="MenuCopyCreds_Click"/>
              <Separator/>
              <MenuItem Header="Open manager" Click="BtnManager_Click"/>
              <MenuItem Header="Hide to tray" Click="BtnHide_Click"/>
            </ContextMenu>
          </TreeView.ContextMenu>
        </TreeView>

      </DockPanel>
    </Border>
  </Grid>
</Window>
