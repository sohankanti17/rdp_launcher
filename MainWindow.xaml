<Window x:Class="RdpLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RdpLauncher"
        Title="RDP Launcher" Height="640" Width="860" Icon="app.ico"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13">
  <Grid Margin="12">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="320"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Left: tree of groups + servers -->
    <DockPanel Grid.Column="0" Margin="0,0,12,0">
      <TextBlock DockPanel.Dock="Top" Text="Connections" FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>

      <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
        <UniformGrid Columns="2" Margin="0,0,0,6">
          <Button x:Name="BtnNewGroup" Content="New group" Height="30" Margin="0,0,4,0" Click="BtnNewGroup_Click"/>
          <Button x:Name="BtnNewVm"    Content="New VM"    Height="30" Margin="4,0,0,0" Click="BtnNewVm_Click"/>
          <Button x:Name="BtnRename"   Content="Rename"    Height="30" Margin="0,6,4,0" Click="BtnRename_Click"/>
          <Button x:Name="BtnDelete"   Content="Delete"    Height="30" Margin="4,6,0,0" Click="BtnDelete_Click"/>
          <Button x:Name="BtnConnectGroup" Content="Connect group" Height="30" Margin="0,6,4,0" Click="BtnConnectGroup_Click"/>
          <Button x:Name="BtnImportRdp"    Content="Import .rdp"   Height="30" Margin="4,6,0,0" Click="BtnImportRdp_Click"/>
          <Button x:Name="BtnImportRdg"    Content="Import RDCMan" Height="30" Margin="0,6,4,0" Click="BtnImportRdg_Click"/>
        </UniformGrid>
        <Separator Margin="0,4"/>
        <Button x:Name="BtnSetupSigning" Content="Enable silent connect" Height="30" Click="BtnSetupSigning_Click"/>
        <TextBlock x:Name="TxtSilentStatus" Margin="2,6,0,0" TextWrapping="Wrap" FontSize="11"/>
      </StackPanel>

      <TreeView x:Name="Tree"
                SelectedItemChanged="Tree_SelectedItemChanged"
                MouseDoubleClick="Tree_MouseDoubleClick">
        <TreeView.Resources>
          <HierarchicalDataTemplate DataType="{x:Type local:Group}" ItemsSource="{Binding Profiles}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
              <TextBlock Text="{Binding Profiles.Count, StringFormat=' ({0})'}" Foreground="Gray"/>
            </StackPanel>
          </HierarchicalDataTemplate>
          <DataTemplate DataType="{x:Type local:Profile}">
            <TextBlock Text="{Binding Name}"/>
          </DataTemplate>
        </TreeView.Resources>
        <TreeView.ItemContainerStyle>
          <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="True"/>
          </Style>
        </TreeView.ItemContainerStyle>
      </TreeView>
    </DockPanel>

    <!-- Right: details for the selected VM -->
    <Grid Grid.Column="1" x:Name="DetailPanel">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="120"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Row="0" Grid.Column="0" Text="Display name" VerticalAlignment="Center" Margin="0,6"/>
      <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TxtName" Height="28" VerticalContentAlignment="Center" Margin="0,6"/>

      <TextBlock Grid.Row="1" Grid.Column="0" Text="Group" VerticalAlignment="Center" Margin="0,6"/>
      <ComboBox  Grid.Row="1" Grid.Column="1" x:Name="CmbGroup" Height="28" VerticalContentAlignment="Center" Margin="0,6"
                 DisplayMemberPath="Name"/>

      <TextBlock Grid.Row="2" Grid.Column="0" Text="Host / IP" VerticalAlignment="Center" Margin="0,6"/>
      <TextBox   Grid.Row="2" Grid.Column="1" x:Name="TxtHost" Height="28" VerticalContentAlignment="Center" Margin="0,6"/>

      <TextBlock Grid.Row="3" Grid.Column="0" Text="Username" VerticalAlignment="Center" Margin="0,6"/>
      <TextBox   Grid.Row="3" Grid.Column="1" x:Name="TxtUser" Height="28" VerticalContentAlignment="Center" Margin="0,6"/>

      <TextBlock Grid.Row="4" Grid.Column="0" Text="Password" VerticalAlignment="Center" Margin="0,6"/>
      <Grid Grid.Row="4" Grid.Column="1" Margin="0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <PasswordBox Grid.Column="0" x:Name="PwdBox" Height="28" VerticalContentAlignment="Center"/>
        <TextBox     Grid.Column="0" x:Name="TxtPwdShown" Height="28" VerticalContentAlignment="Center" Visibility="Collapsed"/>
        <CheckBox    Grid.Column="1" x:Name="ChkShow" Content="Show" VerticalAlignment="Center" Margin="8,0,0,0"
                     Checked="ChkShow_Checked" Unchecked="ChkShow_Unchecked"/>
      </Grid>

      <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,8">
        <CheckBox x:Name="ChkClip"   Content="Share clipboard" IsChecked="True" Margin="0,0,18,0"/>
        <CheckBox x:Name="ChkDrives" Content="Share drives" Margin="0,0,18,0"/>
        <CheckBox x:Name="ChkPrn"    Content="Share printers"/>
      </StackPanel>

      <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
        <CheckBox x:Name="ChkFull"     Content="Full screen" Margin="0,0,18,0"/>
        <CheckBox x:Name="ChkMultimon" Content="Use all monitors" Margin="0,0,18,0"/>
        <CheckBox x:Name="ChkSkipCert" Content="Skip certificate warning (dev VMs)"/>
      </StackPanel>

      <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
        <Button x:Name="BtnSave"    Content="Save" Width="115" Height="34" Margin="0,0,8,0" Click="BtnSave_Click"/>
        <Button x:Name="BtnConnect" Content="Connect" Width="160" Height="34" FontWeight="Bold" Click="BtnConnect_Click"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
